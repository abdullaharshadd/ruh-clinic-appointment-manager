# Docker Environment Configuration
# Copy this file to .env in your project root

# External API Configuration (REQUIRED)
# Replace with your actual Postman mock server URL
MOCK_API_URL=https://your-postman-mock-server-id.mock.pstmn.io

# Database Configuration (Optional - uses defaults from docker-compose.yml)
POSTGRES_DB=wellness_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Application Configuration
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Ports (Optional - modify if you have conflicts)
POSTGRES_PORT=5432
BACKEND_PORT=5000
FRONTEND_PORT=3000
NGINX_PORT=80
